# Environment Variables — AprixFinance
# Copie este arquivo para .env.local e preencha os valores

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Backend de IA (AprixFinanceApi) ───────────────────────────────────────────
NEXT_PUBLIC_FINANCE_API_URL=http://localhost:4000

# ── Web Push Notifications ────────────────────────────────────────────────────
# Gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ── E-mail (Resend) ───────────────────────────────────────────────────────────
# Criar conta em https://resend.com — free tier: 3.000 e-mails/mês
RESEND_API_KEY=re_your_resend_api_key

# ── Vercel Cron ───────────────────────────────────────────────────────────────
# Qualquer string aleatória segura (ex: openssl rand -base64 32)
CRON_SECRET=your_cron_secret
